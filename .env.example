# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables (production).
# Leave the Supabase block empty to run the local demo backend (PGlite) — see README.
# Step-by-step Supabase + Vercel setup (Turkish): KURULUM.md

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for canonical URLs, hreflang, sitemap, OG and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (production) ─────────────────────────────────────────────────────
# DATABASE_URL + URL + publishable (or anon) key together switch the app to the Supabase backend.
# Supabase's Connect dialog shows SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY:
# same values, but the URL and publishable key need the NEXT_PUBLIC_ prefix here. JWKS URL: not needed.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). The legacy "anon" key also works as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (NEVER prefix with NEXT_PUBLIC_ — the app refuses to start if you do).
# Secret key (sb_secret_…); the legacy "service_role" key also works as SUPABASE_SERVICE_ROLE_KEY.
# Used ONLY by lib/auth/accounts.ts to create / reset / delete CLIENT portal logins when a client
# redeems an invite link (public sign-up stays off). Without it the site and admin work, but
# client portal invites are disabled. Storage and data access never use it.
SUPABASE_SECRET_KEY=
#
# Server-only. Transaction pooler connection string (Supabase → Project Settings → Database →
# Connection string → "Transaction pooler", port 6543). Each request runs in a transaction that
# switches to the `authenticated` (with the user's JWT claims) or `anon` role, so RLS applies.
# The RLS-bypassing `service_role` DB role is used only for the public lead intake (after zod
# validation, honeypot and rate limit), the rate-limit counters and the invite peek/redeem functions.
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Required in production. Salt for the hashed IPs used by rate limiting (raw IPs are never stored).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT=

# ── Optional: "Draft translation" button in the admin CMS ─────────────────────
# Only PUBLIC content (recipes, guides) is ever sent. Client data never leaves the app.
# Drafts are saved as "needs review"; ar/fr stay hidden until a native speaker marks them reviewed.
ANTHROPIC_API_KEY=

# ── Local demo backend only (ignored when Supabase is configured) ────────────
# LOCAL_ADMIN_EMAIL=muzahim@local.test
# LOCAL_ADMIN_PASSWORD=mutfak-demo-2026
# Demo client for the portal (/panel), linked to "Deniz Aksoy (demo)"
# LOCAL_CLIENT_EMAIL=danisan@local.test
# LOCAL_CLIENT_PASSWORD=danisan-demo-2026
# LOCAL_DATA_DIR=.demo-data
# 32+ chars; otherwise a random secret is generated into LOCAL_DATA_DIR on first run.
# LOCAL_AUTH_SECRET=
# Lets `next start` use the local backend (e2e against a production build). Never set on Vercel.
# ALLOW_LOCAL_BACKEND=1

# ── Content preview ───────────────────────────────────────────────────────────
# 1 = show Arabic/French content that is not yet "reviewed" (for the reviewer's own preview only).
# Must stay unset in production.
# PREVIEW_UNREVIEWED_TRANSLATIONS=1
